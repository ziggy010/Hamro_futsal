# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/futsal_booking"
DIRECT_URL="postgresql://postgres:password@localhost:5432/futsal_booking"

# Admin login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# Auth / deployment
AUTH_SECRET="replace-with-a-long-random-secret"
# Use https://strikeyard.vercel.app in Vercel Production.
AUTH_URL="http://localhost:3000"

# Email: verify a sending domain in Resend before production use.
RESEND_API_KEY=""
EMAIL_FROM="Strike Yard <bookings@your-domain.com>"
EMAIL_VERIFICATION_ENABLED="false"
